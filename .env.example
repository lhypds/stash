PORT=3204
PM2_NAME=stash

# Optional: route all outbound requests (source analysis, icon downloads) through
# an HTTP/HTTPS/SOCKS proxy — useful when this server's own IP gets served a
# login-wall by sites like Instagram/X that a residential IP wouldn't hit.
# PROXY_URL=http://user:pass@proxy-host:port

# How many reverse proxies sit in front of this server, which is what decides
# the client IP express reports (req.ip). The default trusts the whole
# X-Forwarded-For chain, so the address is ultimately the client's own claim —
# fine for rate limiting, not for settings.safeIPs, which gates nsfw items on
# it. Behind a single nginx, set this to 1 so the address comes from nginx.
# TRUST_PROXY=1
